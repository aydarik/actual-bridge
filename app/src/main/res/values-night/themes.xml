<resources>
    <!-- Dark application theme -->
    <style name="Theme.ActualApp" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <!-- Primary brand color -->
        <item name="colorPrimary">@color/primary</item>
        <item name="colorPrimaryVariant">@color/primary_variant</item>
        <item name="colorOnPrimary">@color/white</item>
        <!-- Secondary brand color -->
        <item name="colorSecondary">@color/primary</item>
        <item name="colorSecondaryVariant">@color/primary_variant</item>
        <item name="colorOnSecondary">@color/white</item>
        <!-- Backgrounds -->
        <item name="android:windowBackground">@color/background</item>
        <item name="colorSurface">@color/surface</item>
        <item name="android:colorBackground">@color/background</item>
        <item name="android:statusBarColor">@color/surface</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:navigationBarColor">@color/background</item>
        <!-- Modern Component Defaults -->
        <item name="textInputStyle">@style/Widget.ActualApp.TextInputLayout.OutlinedBox</item>
        <item name="materialButtonStyle">@style/Widget.ActualApp.Button</item>
        <item name="materialButtonOutlinedStyle">@style/Widget.ActualApp.Button.OutlinedButton</item>
        <item name="borderlessButtonStyle">@style/Widget.ActualApp.Button.TextButton</item>
        <item name="materialAlertDialogTheme">@style/ThemeOverlay.ActualApp.MaterialAlertDialog</item>
        <item name="switchStyle">@style/Widget.ActualApp.Switch</item>
        <item name="boxStrokeColor">@color/text_input_box_stroke</item>
        <item name="boxBackgroundColor">@color/text_input_box_background</item>
        <item name="hintTextColor">?colorPrimary</item>
    </style>

    <!-- Bottom Sheet Overlay Theme for ConfirmTransactionActivity -->
    <style name="Theme.ActualApp.Dialog" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <item name="colorPrimary">@color/primary</item>
        <item name="colorPrimaryVariant">@color/primary_variant</item>
        <item name="colorOnPrimary">@color/white</item>
        <item name="colorSecondary">@color/primary</item>
        <item name="colorSecondaryVariant">@color/primary_variant</item>
        <item name="colorOnSecondary">@color/white</item>
        <item name="colorSurface">@color/surface</item>
        <item name="android:colorBackground">@color/background</item>
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:windowIsFloating">false</item>
        <item name="android:windowIsTranslucent">true</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowAnimationStyle">@style/Animation.ActualApp.BottomSheet</item>
        <item name="android:backgroundDimEnabled">true</item>
        <item name="android:backgroundDimAmount">0.45</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="textInputStyle">@style/Widget.ActualApp.TextInputLayout.OutlinedBox</item>
        <item name="materialButtonStyle">@style/Widget.ActualApp.Button</item>
        <item name="materialButtonOutlinedStyle">@style/Widget.ActualApp.Button.OutlinedButton</item>
        <item name="borderlessButtonStyle">@style/Widget.ActualApp.Button.TextButton</item>
        <item name="materialAlertDialogTheme">@style/ThemeOverlay.ActualApp.MaterialAlertDialog</item>
        <item name="switchStyle">@style/Widget.ActualApp.Switch</item>
        <item name="boxStrokeColor">@color/text_input_box_stroke</item>
        <item name="boxBackgroundColor">@color/text_input_box_background</item>
        <item name="hintTextColor">?colorPrimary</item>
    </style>
</resources>

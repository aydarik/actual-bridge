<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:clipToPadding="false"
    android:padding="22dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/test_title"
            android:textColor="@color/text_primary"
            android:textSize="19sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:layout_marginBottom="14dp"
            android:text="@string/test_desc"
            android:textColor="@color/text_secondary"
            android:textSize="13sp" />

        <!-- Quick Sample Buttons -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="14dp"
            android:orientation="horizontal">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnSampleCoffee"
                style="@style/Widget.ActualApp.Button.OutlinedButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginEnd="5dp"
                android:layout_weight="1"
                android:ellipsize="end"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:minHeight="40dp"
                android:paddingHorizontal="12dp"
                android:paddingVertical="8dp"
                android:singleLine="true"
                android:text="@string/test_sample_payment"
                android:textColor="@color/primary"
                android:textSize="12sp"
                android:textStyle="bold"
                app:backgroundTint="@color/primary_light"
                app:cornerRadius="20dp"
                app:icon="@drawable/ic_arrow_up_right"
                app:iconGravity="textStart"
                app:iconPadding="6dp"
                app:iconSize="16dp"
                app:iconTint="@color/primary"
                app:strokeColor="@color/primary_stroke"
                app:strokeWidth="1dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnSampleSalary"
                style="@style/Widget.ActualApp.Button.OutlinedButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="5dp"
                android:layout_weight="1"
                android:ellipsize="end"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:minHeight="40dp"
                android:paddingHorizontal="12dp"
                android:paddingVertical="8dp"
                android:singleLine="true"
                android:text="@string/test_sample_deposit"
                android:textColor="@color/secondary"
                android:textSize="12sp"
                android:textStyle="bold"
                app:backgroundTint="@color/secondary_light"
                app:cornerRadius="20dp"
                app:icon="@drawable/ic_arrow_down_left"
                app:iconGravity="textStart"
                app:iconPadding="6dp"
                app:iconSize="16dp"
                app:iconTint="@color/secondary"
                app:strokeColor="@color/secondary_stroke"
                app:strokeWidth="1dp" />
        </LinearLayout>

        <!-- Notification Package Name -->
        <com.google.android.material.textfield.TextInputLayout
            style="@style/Widget.ActualApp.TextInputLayout.OutlinedBox"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="10dp"
            android:hint="@string/test_source_package">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etTestPackage"
                android:layout_width="match_parent"
                android:layout_height="wrap_content" />
        </com.google.android.material.textfield.TextInputLayout>

        <!-- Notification Title -->
        <com.google.android.material.textfield.TextInputLayout
            style="@style/Widget.ActualApp.TextInputLayout.OutlinedBox"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="10dp"
            android:hint="@string/test_notif_title">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etTestTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content" />
        </com.google.android.material.textfield.TextInputLayout>

        <!-- Notification Text -->
        <com.google.android.material.textfield.TextInputLayout
            style="@style/Widget.ActualApp.TextInputLayout.OutlinedBox"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            android:hint="@string/test_notif_text">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etTestText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minLines="2" />
        </com.google.android.material.textfield.TextInputLayout>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnRunTest"
            style="@style/Widget.ActualApp.Button"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginBottom="16dp"
            android:text="@string/test_parse_btn"
            app:icon="@drawable/ic_search" />

        <!-- Result Box -->
        <LinearLayout
            android:id="@+id/layoutTestResult"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_rounded_light"
            android:orientation="vertical"
            android:padding="14dp"
            android:visibility="gone">

            <TextView
                android:id="@+id/tvTestStatus"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/test_match_status"
                android:textSize="14sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvTestJson"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:fontFamily="monospace"
                android:textColor="@color/text_primary"
                android:textSize="12sp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnSimulatePopup"
                style="@style/Widget.ActualApp.Button.OutlinedButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="@string/test_simulate_popup"
                android:textColor="@color/secondary"
                app:backgroundTint="?attr/colorSurface"
                app:icon="@drawable/ic_view"
                app:iconTint="@color/secondary"
                app:strokeColor="@color/secondary_stroke" />
        </LinearLayout>
    </LinearLayout>
</ScrollView>
